# =====================================================================
# Esempio di configurazione per l'esecuzione LOCALE come script Python.
# Copia in `.env` e valorizza. NON committare il file `.env` reale.
# =====================================================================

# --- ServiceNow ---
# Solo il nome istanza (es. "acme") oppure l'URL completo https://acme.service-now.com
SERVICENOW_INSTANCE=<NOME_ISTANZA_SERVICENOW>
SERVICENOW_USER=<UTENTE_INTEGRAZIONE_READONLY>
SERVICENOW_PASSWORD=<PASSWORD>
# Tabella sorgente (default: incident)
SERVICENOW_TABLE=incident
# Stati "chiuso": 6=Resolved, 7=Closed (configurabile, CSV)
SERVICENOW_CLOSED_STATES=6,7

# --- Autenticazione ServiceNow ---
# "basic"  -> usa SERVICENOW_USER / SERVICENOW_PASSWORD
# "oauth"  -> password grant via oauth_token.do (servono anche le 3 chiavi sotto)
SERVICENOW_AUTH_MODE=basic
# Necessari solo se SERVICENOW_AUTH_MODE=oauth:
SERVICENOW_OAUTH_CLIENT_ID=<OAUTH_CLIENT_ID>
SERVICENOW_OAUTH_CLIENT_SECRET=<OAUTH_CLIENT_SECRET>
SERVICENOW_OAUTH_TOKEN_PATH=/oauth_token.do

# --- Filtri OPZIONALI (perimetro help desk) ---
# Se lasciati vuoti si estrae TUTTO (nessuna clausola aggiunta).
# Valorizzare con i sys_id (NON i nomi) per restringere.
# Suggerimento: usa `python -m pipeline.list_groups --contains Oracle,JDE` per
# trovare i sys_id dei resolver group.
SERVICENOW_RESOLVER_GROUPS=
SERVICENOW_CONFIGURATION_ITEMS=

# Paginazione / rete Table API
SERVICENOW_PAGE_SIZE=200
SERVICENOW_TIMEOUT_SECONDS=60
SERVICENOW_MAX_RETRIES=5

# --- Watermark / finestra di sovrapposizione (minuti) ---
WATERMARK_OVERLAP_MINUTES=15

# --- Redaction PII - opzionale ---
# Se true, oltre alla redaction regex (password, connection string) maschera
# anche nomi persona, email, telefoni, IBAN/codice fiscale.
PII_REDACTION_ENABLED=false
# Backend: "llm" (default, consigliato) usa un modello chat Azure OpenAI/Foundry;
#          "presidio" usa Presidio + spaCy (NER locale).
PII_BACKEND=llm

# --- PII backend "llm" (default) ---
# Riusa per default endpoint/key di Azure OpenAI degli embedding (AOAI_*).
# Sovrascrivibili con PII_LLM_ENDPOINT / PII_LLM_API_KEY se si vuole una risorsa
# dedicata. Serve un deployment chat (es. gpt-4o-mini) sulla risorsa Foundry.
PII_LLM_DEPLOYMENT=gpt-4o-mini
PII_LLM_API_VERSION=2024-06-01
# PII_LLM_ENDPOINT=
# PII_LLM_API_KEY=

# --- PII backend "presidio" (alternativa NER locale) ---
# Richiede: pip install presidio-analyzer presidio-anonymizer spacy
#           python -m spacy download en_core_web_lg
#           python -m spacy download it_core_news_lg
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,IBAN_CODE,IT_FISCAL_CODE
PII_LANGUAGES=it,en
# Soglia confidenza nomi (piu' bassa = piu' nomi mascherati, piu' falsi positivi)
PII_PERSON_THRESHOLD=0.4

# --- Azure AI Search (servizio ESISTENTE dell'ambiente Copilot Studio/Foundry) ---
SEARCH_ENDPOINT=https://<NOME_SERVIZIO_SEARCH>.search.windows.net
SEARCH_INDEX_NAME=<NOME_INDICE_DESIDERATO>
# Autenticazione: API key oppure Azure AD (RBAC).
#  - SEARCH_USE_AAD=false -> usa SEARCH_ADMIN_KEY (servizio con API keys o "Both")
#  - SEARCH_USE_AAD=true  -> usa DefaultAzureCredential (richiede `az login` e i
#    ruoli "Search Service Contributor" + "Search Index Data Contributor");
#    in questo caso SEARCH_ADMIN_KEY puo' restare vuota.
SEARCH_USE_AAD=false
SEARCH_ADMIN_KEY=<ADMIN_KEY_SEARCH>
SEARCH_API_VERSION=2024-07-01
SEARCH_WRITE_BATCH_SIZE=500

# --- Azure OpenAI / Foundry (embedding) ---
# Endpoint: classico Azure OpenAI (https://<risorsa>.openai.azure.com) oppure
# endpoint unificato Foundry (https://<risorsa>.services.ai.azure.com).
AOAI_ENDPOINT=https://<NOME_RISORSA_AOAI>.openai.azure.com
AOAI_API_KEY=<API_KEY_AOAI>
# Nome del DEPLOYMENT di embedding (non necessariamente uguale al modello).
AOAI_DEPLOYMENT=<NOME_DEPLOYMENT_EMBEDDING>
AOAI_MODEL=text-embedding-3-small
AOAI_DIMENSIONS=1536
AOAI_API_VERSION=2024-02-01
AOAI_BATCH_SIZE=16

# --- Stato (watermark) ---
# In locale: lascia vuota la connection string -> usa il file locale qui sotto.
# In cloud: valorizza con la connection string del Blob Storage.
WATERMARK_BLOB_CONNECTION_STRING=
WATERMARK_BLOB_CONTAINER=ingestion-state
WATERMARK_BLOB_NAME=watermark.json
WATERMARK_LOCAL_PATH=.state/watermark.json
